{
  "name": "webupscayl-desktop",
  "version": "1.0.1",
  "description": "WebUpscayl Desktop - local batch AI image upscaler using Real-ESRGAN NCNN/Vulkan.",
  "main": "src/main.js",
  "author": "WebUpscayl Desktop",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --x64 --publish never",
    "dist:dir": "electron-builder --win dir --x64"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.webupscayl.desktop",
    "productName": "WebUpscayl Desktop",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WebUpscayl Desktop",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "extraResources": [
      {
        "from": "resources/engine",
        "to": "engine"
      }
    ]
  }
}
